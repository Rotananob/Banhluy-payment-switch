# Application
NODE_ENV=development
PORT=3000

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://banhluy:banhluy_dev@localhost:5432/banhluy?schema=public

# JWT (Phase 2 — placeholders for Phase 1)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Internal API authentication (required for /api/internal/* routes)
INTERNAL_API_SECRET=dev-internal-secret-change-in-production

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,https://*.vercel.app

# Internal HTTP client base URL (self-referencing for inter-module calls)
INTERNAL_API_BASE_URL=http://localhost:3000/api/internal

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
